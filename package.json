{
  "name": "shelfcloud-decky",
  "version": "0.3.5",
  "description": "Add cloud games to your Steam library and launch straight into them.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "keywords": [
    "decky",
    "steamdeck",
    "cloud-gaming",
    "boosteroid",
    "geforce-now",
    "xbox-cloud"
  ],
  "author": "Bart Schelstraete",
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bschelst/shelfcloud-decky.git"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "19.1.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "rollup": "^4.53.3",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
