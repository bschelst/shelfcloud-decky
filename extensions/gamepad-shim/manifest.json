{
  "manifest_version": 3,
  "name": "Shelfcloud Gamepad Shim",
  "version": "1.0",
  "description": "Exposes a virtual gamepad before Chrome's user-gesture gate unlocks the real one.",
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*", "*://*.amazon.de/*", "*://*.amazon.co.uk/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.ca/*", "*://*.amazon.nl/*", "*://*.amazon.pl/*", "*://*.amazon.se/*", "*://*.amazon.com.be/*", "*://play.geforcenow.com/*", "*://*.boosteroid.com/*", "*://*.xbox.com/*"],
      "js": ["shim.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
